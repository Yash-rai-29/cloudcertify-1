# === Environment Variables ===
# Prevent committing sensitive credentials or local configurations.
# Use .env.example to store non-sensitive defaults if needed.
.env.local
.env.*.local
# You might also want to ignore .env if you use it for non-local defaults,
# but often .env.example is preferred for tracking in git.
# .env

# === Next.js specific ===
# Ignore the build output directory.
.next/
.out/
# Ignore the static export directory (if using `next export`).
# Uncomment if you use static exports and don't need the output in git.
# out/

# Ignore Turbopack cache (if using Turbopack with Next.js).
.turbo/

# Ignore SWC cache (used for compilation).
.swc/

# === Node.js / Package Manager ===
# Ignore dependency directories. These should be installed via package manager.
node_modules/

# Ignore package manager log files.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore lockfile generated by pnpm
# pnpm-lock.yaml # Usually you *should* commit lockfiles! Only ignore if specifically intended.

# Optional npm cache directory
.npm

# Optional yarn cache directory & files
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# === User Specific (from your request) ===
# Note: The following are covered by ignoring `.next/` above,
# but are listed here for clarity if needed separately.
# .next/cache
# .next/cache/webpack/client-development/10.pack.gz

# Ignore custom config or asset directories as requested.
.config/
.attached_assets/

# === Testing & Coverage ===
# Ignore test report directories.
coverage/
.nyc_output/

# === Build & Temporary Files ===
# Ignore other potential build artifacts or temporary files.
*.tsbuildinfo
*.log
logs/
*.pid
*.seed
*.pid.lock

# === OS generated files ===
# Ignore macOS system files.
.DS_Store
.AppleDouble
.LSOverride

# Ignore Windows system files and thumbnail caches.
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

